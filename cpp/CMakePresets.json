{
  "version": 6,
  "configurePresets": [
    {
      "name": "release",
      "displayName": "Release",
      "description": "Optimised build for this OS with the default GPU backend (Metal on Apple, Vulkan when the SDK is found).",
      "binaryDir": "${sourceDir}/../build",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release"
      }
    },
    {
      "name": "cpu",
      "displayName": "Release, CPU only",
      "inherits": "release",
      "binaryDir": "${sourceDir}/../build-cpu",
      "cacheVariables": {
        "DETTATO_VULKAN": "OFF",
        "DETTATO_METAL": "OFF"
      }
    },
    {
      "name": "debug",
      "displayName": "Debug",
      "inherits": "release",
      "binaryDir": "${sourceDir}/../build-debug",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug"
      }
    },
    {
      "name": "macos-arm64",
      "displayName": "macOS arm64",
      "description": "Apple Silicon, Metal. One architecture per tree.",
      "inherits": "release",
      "binaryDir": "${sourceDir}/../build-macos-arm64",
      "cacheVariables": {
        "CMAKE_OSX_ARCHITECTURES": "arm64"
      }
    },
    {
      "name": "macos-x86_64",
      "displayName": "macOS x86_64",
      "description": "Intel Macs. One architecture per tree.",
      "inherits": "release",
      "binaryDir": "${sourceDir}/../build-macos-x86_64",
      "cacheVariables": {
        "CMAKE_OSX_ARCHITECTURES": "x86_64"
      }
    },
    {
      "name": "windows-x64",
      "displayName": "Windows x64",
      "description": "MSVC or clang-cl, Vulkan when the SDK is installed.",
      "inherits": "release",
      "binaryDir": "${sourceDir}/../build-windows-x64"
    }
  ],
  "buildPresets": [
    { "name": "release", "configurePreset": "release", "configuration": "Release" },
    { "name": "cpu", "configurePreset": "cpu", "configuration": "Release" },
    { "name": "debug", "configurePreset": "debug", "configuration": "Debug" },
    { "name": "macos-arm64", "configurePreset": "macos-arm64", "configuration": "Release" },
    { "name": "macos-x86_64", "configurePreset": "macos-x86_64", "configuration": "Release" },
    { "name": "windows-x64", "configurePreset": "windows-x64", "configuration": "Release" }
  ],
  "testPresets": [
    { "name": "cpu", "configurePreset": "cpu", "configuration": "Release", "output": { "outputOnFailure": true } },
    { "name": "release", "configurePreset": "release", "configuration": "Release", "output": { "outputOnFailure": true } }
  ]
}
